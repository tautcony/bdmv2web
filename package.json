{
  "name": "bdmv2web",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.18.0 <25", "pnpm": "11.25.0" },
  "scripts": {
    "build": "corepack pnpm generate:contracts && corepack pnpm -r build",
    "typecheck": "corepack pnpm build && corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:all": "corepack pnpm -r --no-bail test",
    "generate:contracts": "corepack pnpm --filter @bdmv2web/core generate"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
