{
  "name": "@bdmv2web/runtime-web",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-bundle": "./dist/browser.bundle.js",
    "./bdj-client-bundle": "./dist/bdj-client.bundle.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-runtime-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bdmv2web/bdmv-parser": "workspace:*",
    "@bdmv2web/hdmv": "workspace:*",
    "@bdmv2web/igs": "workspace:*",
    "@bdmv2web/media-export": "workspace:*"
  },
  "devDependencies": {
    "@bdmv2web/test-fixtures": "workspace:*",
    "@types/node": "24.10.0"
  }
